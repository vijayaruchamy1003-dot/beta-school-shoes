# ============================================================================
# Railway PostgreSQL Database Configuration
# ============================================================================
# Option 1 (Recommended on Railway): Reference the Railway Postgres DATABASE_URL directly:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Option 2: Reference Railway's individual PG* variables:
# PGHOST=${{Postgres.PGHOST}}
# PGPORT=${{Postgres.PGPORT}}
# PGDATABASE=${{Postgres.PGDATABASE}}
# PGUSER=${{Postgres.PGUSER}}
# PGPASSWORD=${{Postgres.PGPASSWORD}}
#
# Option 3: Local / Custom PostgreSQL Configuration:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beta_school_shoes
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# Spring Security & JWT Token Secrets
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Direct Payment Gateway Link (Configured directly for customer checkout)
DIRECT_PAYMENT_URL=https://razorpay.me/@vijayaruchamy

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cashfree Payment Gateway (Official API Sandbox/Production)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_API_VERSION=2023-08-01
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_RETURN_URL=http://localhost:5173/orders/{order_id}/status
CASHFREE_NOTIFY_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/api/payments/cashfree/webhook

# Admin Bootstrap Credentials (Initial provision upon first launch)
ADMIN_BOOTSTRAP_EMAIL=admin@betashoes.example.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@Beta2026

# Persistent Storage Settings (On Railway, mount a Volume at /app/uploads and set STORAGE_UPLOAD_DIR=/app/uploads)
STORAGE_TYPE=local
STORAGE_UPLOAD_DIR=./uploads
S3_BUCKET_NAME=beta-shoes-product-images
AWS_REGION=ap-south-1

# Order Reservation Timer (Minutes)
ORDER_RESERVATION_MINUTES=15

# Frontend Environment Variable (Set on Frontend host / Vercel / Railway)
VITE_API_BASE_URL=https://beta-shoes-backend-production.up.railway.app
