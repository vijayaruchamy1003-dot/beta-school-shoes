{
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "https://beta-shoes-backend-production.up.railway.app/uploads/$1"
    },
    {
      "source": "/api/products/images/(.*)",
      "destination": "https://beta-shoes-backend-production.up.railway.app/api/products/images/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
